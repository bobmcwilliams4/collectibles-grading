# =============================================================================
# EPOCGS Website Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
#
# REQUIRED variables are marked with [REQUIRED]
# OPTIONAL variables are marked with [OPTIONAL]
#
# For Firebase configuration, get values from:
# https://console.firebase.google.com/project/echo-prime-ai/settings/general
# =============================================================================

# =============================================================================
# FIREBASE CLIENT CONFIGURATION [REQUIRED]
# =============================================================================
# These are public client-side configuration values (safe to expose)
# Get these from Firebase Console > Project Settings > General > Your apps

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=echo-prime-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=echo-prime-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=echo-prime-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# [OPTIONAL] Additional Firebase config
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://echo-prime-ai-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# FIREBASE ADMIN SDK (Server-Side) [REQUIRED for API routes]
# =============================================================================
# Get these from Firebase Console > Project Settings > Service accounts
# Generate a new private key and extract the values

FIREBASE_PROJECT_ID=echo-prime-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@echo-prime-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Admin Private Key Here\n-----END PRIVATE KEY-----\n"

# =============================================================================
# STRIPE CONFIGURATION [REQUIRED for payments]
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys

# Live keys (production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_secret_key

# Test keys (development) - uncomment these for testing
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_test_secret_key

# Webhook secret for Stripe webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================================================
# APPLICATION CONFIGURATION [OPTIONAL]
# =============================================================================

# Base URL for the application (used for absolute URLs)
NEXT_PUBLIC_BASE_URL=https://epocgs.echo-op.com

# Debug mode (set to true for development)
DEBUG=false

# =============================================================================
# AI GRADING SERVICES [OPTIONAL - for AI-powered grading]
# =============================================================================

# OpenAI (GPT-4 Vision)
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# Google (Gemini)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# STORAGE CONFIGURATION [OPTIONAL]
# =============================================================================

# Maximum file upload size (in bytes)
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# ANALYTICS [OPTIONAL]
# =============================================================================

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# RATE LIMITING [OPTIONAL]
# =============================================================================

# Maximum requests per minute per user
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
