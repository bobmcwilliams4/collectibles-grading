# =============================================================================
# COLLECTIBLES GRADING API - PRODUCTION ENVIRONMENT
# Copy this to .env and fill in your values
# =============================================================================

# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this

# API Keys (Required for AI Grading)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AI...

# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=sqlite:///./data/database/collectibles.db

# CORS - Update with your domain
CORS_ORIGINS=https://echo-op.com,https://www.echo-op.com,https://api.echo-op.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Image Storage
MAX_IMAGE_SIZE_MB=10
IMAGE_STORAGE_PATH=/app/data/images

# Logging
LOG_LEVEL=INFO
