    "swarm": {
        "enabled": true,
        "max_parallel_graders": 15,
        "min_consensus_providers": 3,
        "use_all_free_models": true,
        "vision_models_tier1": [
            "claude",
            "gemini",
            "openrouter_qwen"
        ],
        "vision_models_tier2": [
            "openrouter_llama4_maverick",
            "openrouter_mistral_small",
            "openrouter_gemma3",
            "grok",
            "groq"
        ],
        "vision_models_tier3": [
            "openrouter_llama",
            "openrouter_kimi",
            "cloudflare",
            "huggingface",
            "ollama"
        ],
        "research_providers": [
            "perplexity",
            "cohere",
            "deepseek"
        ],
        "data_scrapers": [
            "ebay",
            "cgc_census",
            "gpa"
        ]
    },

    "consensus": {
        "min_providers": 3,
        "agreement_threshold": 0.85,
        "confidence_threshold": 0.80,
        "defect_confirmation_count": 2,
        "grade_tolerance": 0.5,
        "front_weight": 0.70,
        "back_weight": 0.30,
        "stricter_grade_bias": 0.3
    },

    "pricing_sources": {
        "gpa": {
            "enabled": true,
            "weight": 0.40,
            "rate_limit_seconds": 2.0
        },
        "heritage": {
            "enabled": true,
            "weight": 0.35,
            "rate_limit_seconds": 2.0
        },
        "ebay": {
            "enabled": true,
            "weight": 0.25,
            "rate_limit_seconds": 1.5,
            "fetch_sold": true,
            "fetch_active": true
        },
        "cgc_census": {
            "enabled": true,
            "rate_limit_seconds": 1.5
        }
    },

    "grading": {
        "cgc_scale": {
            "10.0": "Gem Mint",
            "9.9": "Mint",
            "9.8": "Near Mint/Mint",
            "9.6": "Near Mint+",
            "9.4": "Near Mint",
            "9.2": "Near Mint-",
            "9.0": "Very Fine/Near Mint",
            "8.5": "Very Fine+",
            "8.0": "Very Fine",
            "7.5": "Very Fine-",
            "7.0": "Fine/Very Fine",
            "6.5": "Fine+",
            "6.0": "Fine",
            "5.5": "Fine-",
            "5.0": "Very Good/Fine",
            "4.5": "Very Good+",
            "4.0": "Very Good",
            "3.5": "Very Good-",
            "3.0": "Good/Very Good",
            "2.5": "Good+",
            "2.0": "Good",
            "1.8": "Good-",
            "1.5": "Fair/Good",
            "1.0": "Fair",
            "0.5": "Poor"
        },
        "strictness": "stringent",
        "notes": "Be stringent - most circulated comics grade 4.0-7.5. 9.0+ is RARE."
    },

    "image_processing": {
        "max_dimension": 2048,
        "quality_threshold": 0.85,
        "enable_preprocessing": true,
        "preprocessing_steps": ["orientation", "crop", "enhance", "denoise"]
    },

    "caching": {
        "enabled": true,
        "ttl_seconds": 86400,
        "max_size_mb": 500
    }
}
