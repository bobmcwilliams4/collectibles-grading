    "goldmine_scale": {
        "record_grades": {
            "M": {
                "label": "Mint",
                "numeric": 10,
                "description": "A perfect, unplayed record. The record must be completely free of any defects, including no spindle marks from being on a turntable. Brand new and sealed would qualify."
            },
            "NM": {
                "label": "Near Mint",
                "numeric": 9,
                "description": "A nearly perfect record. The record shows no obvious signs of wear. A light scuff that does not affect the play might be acceptable. Surface noise should be minimal."
            },
            "VG+": {
                "label": "Very Good Plus",
                "numeric": 8,
                "description": "Shows some signs of being played but still presents well. Surface noise will be evident during quiet passages or between songs, but should not overpower the music."
            },
            "VG": {
                "label": "Very Good",
                "numeric": 6,
                "description": "Surface noise is evident on playback, but still does not make the music unlistenable. Groove wear is starting to affect the sound quality. Light scratches may be present."
            },
            "G+": {
                "label": "Good Plus",
                "numeric": 4,
                "description": "A record that has been played extensively. Significant surface noise and distortion during playback. Major visible wear, but the record still plays through without skipping."
            },
            "G": {
                "label": "Good",
                "numeric": 2,
                "description": "Surface noise is loud and constant. The music may be distorted. Major scratches that may affect playability. Still plays through but barely."
            },
            "F": {
                "label": "Fair",
                "numeric": 1,
                "description": "Barely playable. Significant skipping and jumping. Only for collectors who need a placeholder copy."
            },
            "P": {
                "label": "Poor",
                "numeric": 0,
                "description": "Unplayable without skipping. Cracked, broken, or severely warped. Collector value only if extremely rare."
            }
        },
